---
// Head metadata of one page: title, description, canonical on the build origin, robots, Open Graph, Twitter, JSON-LD.
// Titles and descriptions are written per page from its own captured text (docs/redesign: SEO).
import { getImage } from 'astro:assets';
import { INDEXABLE, SITE_NAME } from '../lib/site.mjs';
import ogDefault from '../assets/photos/hero.jpg';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  noCanonical?: boolean;
  jsonLd?: object[];
}
const { title, description, image = ogDefault, imageAlt = 'BikeOne: Radfahrer vor einem Bergpanorama', type = 'website', noindex = false, noCanonical = false, jsonLd = [] } = Astro.props;
const origin = Astro.site!;
const canonical = new URL(Astro.url.pathname, origin).href;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, origin).href;
// "<" is escaped so no string in the data can close the script element
const ld = jsonLd.map((node) => JSON.stringify(node).replace(/</g, '\\u003c'));
---
<title>{title}</title>
<meta name="description" content={description} />
{!noCanonical && <link rel="canonical" href={canonical} />}
{(!INDEXABLE || noindex) && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="de_DE" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noCanonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{ld.map((json) => <script type="application/ld+json" set:html={json} />)}
