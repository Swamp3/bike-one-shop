---
// Head metadata of one page: title, description, canonical on the build origin, robots, Open Graph, Twitter, JSON-LD.
// Titles and descriptions are written per page from its own captured text (docs/redesign: SEO).
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { berlinIso, INDEXABLE, SITE_NAME } from '../lib/site.mjs';
import { graph, organizationNode, websiteNode } from '../lib/schema';
import ogDefault from '../assets/photos/hero.jpg';
import icon from '../assets/brand/icon.png';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  noCanonical?: boolean;
  published?: Date;
  modified?: Date;
  /** Page-specific schema.org nodes (stores, article, breadcrumbs); Organization and WebSite are added here on every page. */
  nodes?: Record<string, unknown>[];
}
const { title, description, image = ogDefault, imageAlt = 'BikeOne: Radfahrer vor einem Bergpanorama', type = 'website', noindex = false, noCanonical = false, published, modified, nodes = [] } = Astro.props;
const origin = Astro.site!;
const canonical = new URL(Astro.url.pathname, origin).href;
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, origin).href;
// The 404 page answers for any URL and carries no data. Every other page gets Organization and WebSite next to its own
// nodes, so each @id reference resolves inside the page (a checked rule); "<" is escaped so no string can close the script.
let ld: string[] = [];
if (!noCanonical) {
  const logo = new URL((await getImage({ src: icon, width: 512, height: 512, format: 'png' })).src, origin).href;
  const brands = (await getCollection('brands')).map((b) => b.data.name);
  const storeIds = nodes.filter((n) => n['@type'] === 'BikeStore').map((n) => String(n['@id']));
  ld = [JSON.stringify(graph([organizationNode(origin.href, logo, brands, storeIds), websiteNode(origin.href), ...nodes])).replace(/</g, '\\u003c')];
}
---
<title>{title}</title>
<meta name="description" content={description} />
{!noCanonical && <link rel="canonical" href={canonical} />}
{(!INDEXABLE || noindex) && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="de_DE" />
{type === 'article' && published && <meta property="article:published_time" content={berlinIso(published)} />}
{type === 'article' && modified && <meta property="article:modified_time" content={berlinIso(modified)} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noCanonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{ld.map((json) => <script type="application/ld+json" set:html={json} />)}
