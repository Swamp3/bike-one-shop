---
// Third-party embed behind a click: nothing loads from the provider until the visitor asks for it.
// The iframe sits in a <template>, the script moves it into the page on click (decision d34).
// `openUrl` adds a plain link for visitors without JavaScript (and as an alternative): nothing is requested by a link
// until it is followed.
interface Props { src: string; title: string; provider: string; subject: string; label: string; ratio?: 'wide' | 'tall' | 'app'; openUrl?: string; openLabel?: string }
const { src, title, provider, subject, label, ratio = 'tall', openUrl, openLabel } = Astro.props;
---
<div class="embed" data-embed data-ratio={ratio}>
  <div class="gate">
    <p>{subject} wird von {provider} bereitgestellt. Beim Laden verbindet sich dein Browser mit {provider} und deine IP-Adresse wird übertragen.</p>
    <button type="button" class="btn btn--ghost" data-embed-load>{label}</button>
    {openUrl && <a class="open" href={openUrl}>{openLabel}</a>}
  </div>
  <template><iframe src={src} title={title} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></template>
</div>
<style>
  .embed { position: relative; background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .embed[data-ratio='wide'] { aspect-ratio: 16 / 9; }
  .embed[data-ratio='tall'] { aspect-ratio: 4 / 3; }
  .embed[data-ratio='app'] { height: 18rem; }
  .embed[data-ratio='app'][data-loaded] { height: min(88vh, 62rem); min-height: 36rem; }
  .gate .open { font-size: 0.95rem; display: inline-flex; align-items: center; min-height: 2.75rem; }
  .gate { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-3); padding: var(--space-4); text-align: center; }
  .gate p { margin: 0; max-width: 32rem; font-size: 0.95rem; color: var(--ink-muted); }
  .embed :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
<script>
  // One delegated listener for every embed on the page.
  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest('[data-embed-load]');
    const box = button?.closest<HTMLElement>('[data-embed]');
    const tpl = box?.querySelector('template');
    if (!box || !tpl) return;
    box.querySelector('.gate')?.remove();
    box.setAttribute('data-loaded', '');
    box.append(tpl.content.cloneNode(true));
    tpl.remove();
    // the button that had the focus is gone: hand the focus to the embedded page so keyboard use goes on there
    box.querySelector('iframe')?.focus();
  });
</script>
