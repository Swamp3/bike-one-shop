---
// Site header: logo, menu, one clear primary action. The menu is a popover (no JavaScript): a button on narrow
// screens, always visible from 48rem (author CSS overrides the UA's display:none of a closed popover).
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-white.png';
import { SHOP_URL } from '../lib/site.mjs';

const path = Astro.url.pathname;
const links = [
  { href: '/termin-buchen/', label: 'Termin buchen' },
  { href: '/service/', label: 'Service' },
  { href: '/blog/', label: 'Blog' },
  { href: '/ueber-uns/', label: 'Über uns' },
  { href: SHOP_URL, label: 'Shop', shop: true },
];
---
<header class="site-header dark">
  <div class="container bar">
    <a class="brand" href="/">
      <Image src={logo} alt="BikeOne, zur Startseite" height={28} widths={[175, 350]} sizes="175px" loading="eager" />
    </a>
    <button class="menu-btn" type="button" popovertarget="site-nav" popovertargetaction="toggle">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 5h16M2 10h16M2 15h16" /></svg>
      <span>Menü</span>
    </button>
    <nav id="site-nav" class="nav" popover aria-label="Hauptmenü">
      <ul>
        {links.map((l) => (
          <li>
            <a class:list={['nav-link', { shop: l.shop }]} href={l.href} aria-current={!l.shop && path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--header-bg); color: var(--header-text); border-bottom: 1px solid var(--header-line); }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: var(--header-h); gap: var(--space-4); }
  .brand { display: block; line-height: 0; }
  .brand img { height: 1.75rem; width: auto; }
  .menu-btn { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 2.75rem; padding: 0 var(--space-4); background: transparent; color: inherit; border: 1px solid #6b6b6b; border-radius: var(--radius); font: 700 1rem/1 var(--font-body); cursor: pointer; }
  .menu-btn:hover { border-color: #fff; }

  /* narrow: a panel under the header */
  .nav { position: fixed; inset: var(--header-h) 0 auto 0; width: 100%; margin: 0; padding: var(--space-3) var(--space-4) var(--space-5); border: 0; background: var(--header-surface); color: var(--header-text); border-bottom: 1px solid var(--header-line); }
  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .nav-link { display: block; padding: var(--space-3) 0; color: inherit; text-decoration: none; font: 700 1.15rem/1.3 var(--font-head); border-bottom: 1px solid var(--header-line); }
  .nav li:last-child .nav-link { border-bottom: 0; }
  .nav-link:hover { color: var(--header-muted); }
  .nav-link[aria-current='page'] { box-shadow: inset 3px 0 0 var(--accent); padding-left: var(--space-3); }
  .nav-link.shop { color: #fff; }

  @media (min-width: 48rem) {
    .menu-btn { display: none; }
    .nav { position: static; inset: auto; width: auto; padding: 0; border: 0; background: transparent; overflow: visible; display: block; }
    .nav ul { flex-direction: row; align-items: center; gap: var(--space-5); }
    .nav-link { padding: var(--space-2) 0; border: 0; font-size: 1.05rem; }
    .nav-link[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--accent); padding-left: 0; }
    .nav-link.shop { background: var(--accent-strong); padding: 0.55rem 1.1rem; border-radius: var(--radius); }
    .nav-link.shop:hover { background: var(--accent-strong-hover); color: #fff; }
  }
</style>
