---
// Header and mobile header as captured; a page whose copy differs (current-menu-item) has its own file.
const { slug, own = [] } = Astro.props;
const parts = import.meta.glob('../content/parts/*.html', { query: '?raw', import: 'default', eager: true });
const part = (name) => parts[`../content/parts/${own.includes(name) ? slug + '.' : ''}${name}.html`];
---
<Fragment set:html={part('header')} /><Fragment set:html={parts['../content/parts/mobile.html']} />
