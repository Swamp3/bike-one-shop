---
import type { Crumb } from '../lib/schema';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav class="crumbs" aria-label="Brotkrumen">
  <ol>
    {crumbs.map((c, i) => (
      <li>{i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; margin: 0 0 var(--space-2); padding: 0; font-size: 0.9rem; color: var(--ink-muted); align-items: center; }
  .crumbs li + li::before { content: '›'; margin-right: var(--space-2); }
  .crumbs a { color: var(--ink-muted); display: inline-flex; align-items: center; min-height: 2.75rem; min-width: 2.75rem; }
  .crumbs span { display: inline-flex; align-items: center; min-height: 2.75rem; }
</style>
