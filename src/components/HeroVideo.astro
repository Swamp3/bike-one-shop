---
// Background video of the home hero, laid over the poster photo (decision d51). The file is H.264, no audio, faststart
// (public/hero.mp4, see tools/mp4-info.mjs). `preload="none"` means the browser requests nothing until the script calls
// play(), which it does only when motion is welcome: not with prefers-reduced-motion, not with Save-Data, not on narrow
// screens (17 MiB), and only after the page has loaded so the poster stays the LCP element.
// Safari needs the muted and playsinline PROPERTIES and an explicit play() to start without a click (d25/d26).
---
<video class="hero-video" src="/hero.mp4" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" data-hero-video></video>
<button class="hero-toggle" type="button" hidden data-hero-toggle aria-label="Hintergrundvideo anhalten">
  <svg class="i-pause" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><rect x="3" y="2" width="3.5" height="12" rx="1" /><rect x="9.5" y="2" width="3.5" height="12" rx="1" /></svg>
  <svg class="i-play" aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M4 2.5v11a1 1 0 0 0 1.5.86l9-5.5a1 1 0 0 0 0-1.72l-9-5.5A1 1 0 0 0 4 2.5z" /></svg>
</button>

<style>
  .hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero-toggle { position: absolute; right: var(--space-4); top: var(--space-4); z-index: 2; display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: 0; background: #121212b3; color: #fff; border: 1px solid #ffffff80; border-radius: 999px; cursor: pointer; }
  .hero-toggle:hover { background: #121212; border-color: #fff; }
  .hero-toggle[hidden] { display: none; }
  .hero-toggle .i-play { display: none; }
  .hero-toggle[aria-pressed='true'] .i-pause { display: none; }
  .hero-toggle[aria-pressed='true'] .i-play { display: block; }
</style>
<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  if (video && toggle) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const wide = matchMedia('(min-width: 48rem)');
    const saveData = Boolean((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData);
    let userPaused = false;
    const allowed = () => !reduced.matches && wide.matches && !saveData;

    // A browser that refuses autoplay (WebKit without a user gesture, iOS Low Power Mode) rejects play(): the poster stays
    // and the first tap, click or key press starts the video instead.
    const events = ['pointerdown', 'keydown', 'touchend'];
    const unlock = () => { events.forEach((e) => removeEventListener(e, unlock)); play(); };
    const play = () => {
      if (!allowed() || userPaused || !video.paused) return;
      video.muted = true; // the property, not only the attribute: Safari checks it before it allows autoplay
      video.defaultMuted = true;
      video.playsInline = true;
      video.play().catch(() => events.forEach((e) => addEventListener(e, unlock, { once: true, passive: true })));
    };
    const stop = () => { video.pause(); video.classList.remove('is-playing', 'is-paused'); toggle.hidden = true; };

    video.addEventListener('playing', () => { video.classList.add('is-playing'); video.classList.remove('is-paused'); toggle.hidden = false; toggle.setAttribute('aria-pressed', 'false'); toggle.setAttribute('aria-label', 'Hintergrundvideo anhalten'); });
    toggle.addEventListener('click', () => {
      userPaused = !video.paused;
      if (userPaused) { video.pause(); video.classList.replace('is-playing', 'is-paused'); toggle.setAttribute('aria-pressed', 'true'); toggle.setAttribute('aria-label', 'Hintergrundvideo abspielen'); }
      else play();
    });
    const recheck = () => (allowed() ? play() : stop());
    reduced.addEventListener('change', recheck);
    wide.addEventListener('change', recheck);
    document.addEventListener('visibilitychange', () => { if (!document.hidden && video.paused && video.classList.contains('is-playing')) play(); });

    // the page, its poster and styles first; then the video
    if (document.readyState === 'complete') play(); else addEventListener('load', play, { once: true });
  }
</script>
