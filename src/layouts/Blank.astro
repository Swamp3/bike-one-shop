---
// A page the theme renders with no header or footer (/alle-fahrrader/): body is its content, then the scripts.
import Base from './Base.astro';
const { meta, html, headExtra, bottom, seo } = Astro.props;
---
<Base {...seo} lang={meta.lang} bodyClass={meta.bodyClass} css={meta.css}>
  <Fragment slot="head" set:html={headExtra} />
  <Fragment set:html={html} />
  <Fragment set:html={bottom} />
</Base>
