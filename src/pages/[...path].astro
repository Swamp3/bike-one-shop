---
import Page from '../layouts/Page.astro';
import Blank from '../layouts/Blank.astro';
import index from '../content/index.json';
import seoAll from '../../baseline/seo.json';
const mains = import.meta.glob('../content/pages/*.html', { query: '?raw', import: 'default', eager: true });
const heads = import.meta.glob('../content/heads/*.html', { query: '?raw', import: 'default', eager: true });
const bottoms = import.meta.glob('../content/bottoms/*.html', { query: '?raw', import: 'default', eager: true });

export function getStaticPaths() {
  return Object.entries(index).filter(([, m]) => !m.special).map(([slug, meta]) => ({
    params: { path: meta.path === '/' ? undefined : meta.path.replace(/^\/|\/$/g, '') },
    props: { slug, meta },
  }));
}
const { slug, meta } = Astro.props;
const s = seoAll[meta.path] || {};
const seo = { title: s.title, description: s.description, canonical: s.canonical, robots: s.robots };
const props = { slug, meta, seo, html: mains[`../content/pages/${slug}.html`], headExtra: heads[`../content/heads/${slug}.html`], bottom: bottoms[`../content/bottoms/${slug}.html`] };
const Layout = meta.blank ? Blank : Page;
---
<Layout {...props} />
