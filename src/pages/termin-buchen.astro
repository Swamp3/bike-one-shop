---
// /termin-buchen/: choose a location. Facts come from the stores collection (captured footer and booking page).
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StoreCard from '../components/StoreCard.astro';
import { getStores } from '../lib/stores';
import { breadcrumbNode, graph, storeNode } from '../lib/schema';

const stores = await getStores();
const origin = Astro.site!.href;
const crumbs = [{ name: 'Startseite', path: '/' }, { name: 'Termin buchen', path: '/termin-buchen/' }];
---
<Base
  title="Termin buchen in Oldenburg & Osnabrück – BikeOne"
  description="BikeOne: Termin online buchen, in Oldenburg (Rheinstraße 16) oder Osnabrück (Lengericher Landstraße 30). Standort wählen und freien Termin finden."
  jsonLd={[graph([...stores.map((s) => storeNode(origin, s)), breadcrumbNode(origin, crumbs)])]}
>
  <div class="container page">
    <Breadcrumbs crumbs={crumbs} />
    <h1>Termin buchen</h1>
    <h2 class="question">Wo möchtest du einen Termin buchen?</h2>
    <div class="store-grid">
      {stores.map((s) => <StoreCard store={s} level={3} />)}
    </div>
    <p class="more">Mehr zu Beratung, Fitting und Werkstatt: <a href="/service/">unser Service</a>.</p>
  </div>
</Base>

<style>
  .page { padding-block: var(--space-6) var(--space-8); }
  .question { font-size: 1.5rem; font-weight: 400; font-family: var(--font-body); color: var(--ink-muted); margin-bottom: var(--space-5); }
  .store-grid { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); }
  .more { margin-top: var(--space-5); }
</style>
