---
// Impressum and Datenschutz: the captured text word for word (src/content/legal/*.md), in the shared shell.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbNode, graph } from '../lib/schema';

export async function getStaticPaths() {
  return (await getCollection('legal')).map((entry) => ({ params: { legal: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const crumbs = [{ name: 'Startseite', path: '/' }, { name: entry.data.title, path: Astro.url.pathname }];
---
<Base title={entry.data.seoTitle} description={entry.data.description} jsonLd={[graph([breadcrumbNode(Astro.site!.href, crumbs)])]}>
  <div class="container doc">
    <Breadcrumbs crumbs={crumbs} />
    <article class="prose"><Content /></article>
  </div>
</Base>

<style>
  .doc { padding-block: var(--space-6) var(--space-8); }
  .prose { max-width: 46rem; }
  .prose :global(h1) { margin-bottom: var(--space-5); }
  .prose :global(h2) { font-size: 1.5rem; margin: var(--space-6) 0 var(--space-3); }
  .prose :global(ul) { margin: 0 0 var(--space-4); }
  .prose :global(li) { margin-bottom: var(--space-1); }
</style>
