---
// The live site's own 404 page (capture/pages/404.html), in the shared layout.
import Page from '../layouts/Page.astro';
import index from '../content/index.json';
const mains = import.meta.glob('../content/pages/404.html', { query: '?raw', import: 'default', eager: true });
const heads = import.meta.glob('../content/heads/404.html', { query: '?raw', import: 'default', eager: true });
const bottoms = import.meta.glob('../content/bottoms/404.html', { query: '?raw', import: 'default', eager: true });
const meta = index['404'];
const props = { slug: '404', meta, seo: { title: meta.title, robots: 'noindex' }, html: mains['../content/pages/404.html'], headExtra: heads['../content/heads/404.html'], bottom: bottoms['../content/bottoms/404.html'] };
---
<Page {...props} />
