---
// /termin-buchen-oldenburg/ and /termin-buchen-osnabrueck/: the store's facts and its etermin.net booking page behind a
// click: no request goes to etermin.net before the visitor asks for it (decision d34).
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Embed from '../components/Embed.astro';
import { getStores, shortHours } from '../lib/stores';
import { breadcrumbNode, graph, storeNode } from '../lib/schema';

export async function getStaticPaths() {
  const stores = await getStores();
  return stores.map((store) => ({ params: { booking: store.data.bookingPath.replaceAll('/', '') }, props: { store, other: stores.find((s) => s.id !== store.id)! } }));
}
const { store, other } = Astro.props;
const d = store.data;
const origin = Astro.site!.href;
const crumbs = [{ name: 'Startseite', path: '/' }, { name: 'Termin buchen', path: '/termin-buchen/' }, { name: d.name, path: d.bookingPath }];
---
<Base
  title={`Termin buchen in ${d.name} – BikeOne`}
  description={`Online-Termin bei BikeOne ${d.name}, ${d.street}: ${shortHours(store).join(', ')} Uhr. Freien Termin wählen und direkt buchen.`}
  jsonLd={[graph([storeNode(origin, store), breadcrumbNode(origin, crumbs)])]}
>
  <div class="container page">
    <Breadcrumbs crumbs={crumbs} />
    <h1>Termin buchen in {d.name}</h1>
    <div class="facts">
      <address>
        <strong>BikeOne GmbH {d.name}</strong><br />
        {d.street}<br />{d.postalCode} {d.city}<br />
        <a href={`tel:${d.phoneTel}`}>{d.phone}</a><br />
        <a href={`mailto:${d.email}`}>{d.email}</a>
      </address>
      <div>
        <p class="label">Öffnungszeiten</p>
        <dl class="hours">
          {d.hours.map((h) => (<><dt>{h.label}</dt><dd>{h.opens}–{h.closes} Uhr</dd></>))}
          <dt>{d.closed}</dt><dd>geschlossen</dd>
        </dl>
      </div>
    </div>
    <Embed src={d.bookingUrl} title={`Terminbuchung BikeOne ${d.name}`} provider="eTermin" label="Terminbuchung laden" ratio="app" openUrl={d.bookingUrl} openLabel="Terminbuchung bei eTermin öffnen" />
    <ul class="links">
      <li><a href={other.data.bookingPath}>Termin buchen in {other.data.name}</a></li>
      <li><a href="/ueber-uns/">Standorte und Karte</a></li>
      <li><a href="/service/">Unser Service</a></li>
    </ul>
  </div>
</Base>

<style>
  .page { padding-block: var(--space-6) var(--space-8); }
  .facts { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); margin-bottom: var(--space-6); }
  address { line-height: 1.7; }
  .label { font: 700 0.85rem/1 var(--font-head); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-muted); margin-bottom: var(--space-2); }
  .hours { margin: 0; }
  .hours dt { font-weight: 700; }
  .hours dd { margin: 0 0 var(--space-2); }
  .links { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); padding: 0; margin: var(--space-5) 0 0; }
</style>
