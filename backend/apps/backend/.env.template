STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
# Dev only: with NODE_ENV=production the backend refuses to start on these two
# values. Generate real ones with: openssl rand -hex 32
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# SumUp payment provider — see PLAN.md / SUMUP_SETUP.md. Leave any of
# SUMUP_API_KEY/SUMUP_MERCHANT_CODE/SUMUP_WEBHOOK_SECRET empty and the
# provider stays disabled; medusa-config.ts only registers it once all three
# are set.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_CHECKOUT_MODE=hosted
# Shared secret appended to the webhook callback URL registered with SumUp;
# src/api/middlewares.ts rejects any POST to /hooks/payment/sumup_sumup
# without a matching wh_secret query param. Generate with: openssl rand -hex 32
SUMUP_WEBHOOK_SECRET=
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000

# TriCon/Tridata ERP sync — see planning/3-Architecture_Tech_Stack/
# tricon-mock-contract.md. The sync (jobs, order.placed upload, admin "TriCon
# Sync" page actions) only runs when an endpoint AND a GUID are set; leave
# either empty and everything TriCon-related skips quietly. The GUID is a
# secret (never logged or shown in the admin).
# Local TriCon mock (backend/apps/tricon-mock): `make setup` fills these in
# when empty:
#   TRIDATA_ENDPOINT_URL=http://localhost:3001/soap
#   TRIDATA_IDENTIFY_GUID=00000000-0000-0000-0000-000000000001
TRIDATA_ENDPOINT_URL=
# Optional alternative to TRIDATA_ENDPOINT_URL: the WSDL URL, "?wsdl" is stripped.
TRIDATA_WSDL_URL=
TRIDATA_IDENTIFY_GUID=
# With NODE_ENV=production the integration refuses the mock GUID above and any
# non-https endpoint (logs one error, sync stays off). Set this to true ONLY on
# the test server, which talks to the mock on http://127.0.0.1:3001/soap.
TRIDATA_ALLOW_INSECURE_ENDPOINT=false
# TriBike Filialname -> Medusa stock_location.name (JSON).
TRIDATA_BRANCH_MAP={"Oldenburg":"BikeOne Oldenburg","Osnabrück":"BikeOne Osnabrück"}
# Added to order.display_id to form TriCon's WebShopOrderID. Every environment
# that talks to the same TriCon must use its own range, e.g. 0 locally,
# 1000000 on the test server; never change it once orders were uploaded.
TRIDATA_ORDER_ID_OFFSET=0
# Data minimisation: customer phone numbers are only sent in UploadOrder when true.
TRIDATA_SEND_PHONE=false
# Days to keep tridata_sync_log rows (purged daily at 03:30).
TRIDATA_SYNC_LOG_RETENTION_DAYS=30
# Cron for the stock delta sync job: every minute in dev; use */10 * * * * in
# prod. The first run after 03:00 each day is a full (non-delta) sync.
TRIDATA_STOCK_SYNC_CRON=* * * * *
# Optional overrides (defaults shown): order-state poll and failed-upload retry.
# TRIDATA_ORDER_STATE_SYNC_CRON=*/5 * * * *
# TRIDATA_ORDER_RETRY_CRON=*/2 * * * *
# TRIDATA_TIMEOUT_MS=15000
# TRIDATA_SOAP_NAMESPACE=http://tempuri.org/

# Order confirmation e-mails. Leave empty in dev: notification-local only logs
# (nothing is sent). A real provider needs all three. SendGrid ships with
# Medusa: NOTIFICATION_PROVIDER_RESOLVE=@medusajs/medusa/notification-sendgrid.
# Any other provider (Resend has no official one) must be a module taking
# api_key + from, see EMAIL_SETUP.md. In production the backend
# refuses to start without them, unless NOTIFICATION_ALLOW_NONE=true is set
# (only for a test server that takes no real orders: no e-mail is sent, and
# every order then logs a "[notification] ... SKIPPED" warning; if you see it on
# a real server, remove this variable).
# STOREFRONT_URL must also be set in production (links in the e-mail).
# NOTIFICATION_ALLOW_NONE=false
# Brevo (see BREVO_SETUP.md, module in src/modules/brevo). Without the provider
# and key set, mail is only logged (dev) or skipped (NOTIFICATION_ALLOW_NONE).
# The API key stays empty here: a Brevo v3 key (restricted, send only), secret,
# only in the server's .env. Empty = not configured = mail is only logged.
NOTIFICATION_PROVIDER_RESOLVE=./src/modules/brevo
NOTIFICATION_API_KEY=
NOTIFICATION_FROM="BikeOne <order@mail.bike-one.dev>"
NOTIFICATION_REPLY_TO=info@bike-one.dev
