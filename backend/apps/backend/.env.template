STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# SumUp payment provider — see PLAN.md / SUMUP_SETUP.md. Leave any of
# SUMUP_API_KEY/SUMUP_MERCHANT_CODE/SUMUP_WEBHOOK_SECRET empty and the
# provider stays disabled; medusa-config.ts only registers it once all three
# are set.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_CHECKOUT_MODE=hosted
# Shared secret appended to the webhook callback URL registered with SumUp;
# src/api/middlewares.ts rejects any POST to /hooks/payment/sumup_sumup
# without a matching wh_secret query param. Generate with: openssl rand -hex 32
SUMUP_WEBHOOK_SECRET=
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000

# TriCon/Tridata ERP sync (no WSDL/sandbox access yet — see
# planning/3-Architecture_Tech_Stack/tricon-integration-notes.md)
TRIDATA_WSDL_URL=
TRIDATA_IDENTIFY_GUID=
