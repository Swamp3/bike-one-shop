---
// Document shell of every native page: head (fonts, styles, SEO), skip link, header, main landmark, footer.
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import condensed700 from '../assets/fonts/roboto-condensed-de-700.woff2?url';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  noCanonical?: boolean;
  /** The LCP image of the page as an AVIF srcset: preloaded with high priority before the stylesheets are parsed. */
  preload?: { srcset: string; sizes: string };
  published?: Date;
  modified?: Date;
  nodes?: Record<string, unknown>[];
}
const { preload, ...props } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121212" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="BikeOne Blog" href="/feed/" />
    <!-- the one above-the-fold font file (headline); everything else swaps in -->
    <link rel="preload" href={condensed700} as="font" type="font/woff2" crossorigin />
    {preload && <link rel="preload" as="image" type="image/avif" imagesrcset={preload.srcset} imagesizes={preload.sizes} fetchpriority="high" />}
    <SEO {...props} />
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
