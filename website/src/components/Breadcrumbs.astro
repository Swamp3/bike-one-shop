---
import type { Crumb } from '../lib/schema';
interface Props { crumbs: Crumb[] }
const { crumbs } = Astro.props;
---
<nav class="crumbs" aria-label="Brotkrumen">
  <ol>
    {crumbs.map((c, i) => (
      <li>{i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  /* one line, the current page may be cut with an ellipsis (a long post title would otherwise wrap and leave a separator at the start of a line) */
  .crumbs ol { display: flex; flex-wrap: nowrap; align-items: center; list-style: none; margin: 0 0 var(--space-4); padding: 0; font-size: 0.9rem; color: var(--ink-muted); }
  .crumbs li { display: flex; align-items: center; flex: 0 0 auto; gap: var(--space-2); }
  .crumbs li + li { margin-left: var(--space-2); }
  .crumbs li + li::before { content: '›'; }
  .crumbs li:last-child { flex: 0 1 auto; min-width: 0; }
  .crumbs a { color: var(--ink-muted); }
  .crumbs [aria-current] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 47.99rem), (pointer: coarse) { /* 44 px targets */
    .crumbs li { min-height: 2.75rem; }
    .crumbs a { display: inline-flex; align-items: center; min-height: 2.75rem; padding-inline: var(--space-2); margin-inline: calc(-1 * var(--space-2)); } /* the padding makes a short word a 44 px wide target without moving the text */
    .crumbs ol { margin-bottom: var(--space-2); }
  }
</style>
