# Every path: security headers and one Content-Security-Policy without third parties (decision d54).
# frame-src names the only three hosts a click-to-load embed may open: etermin.net (booking), Google Maps (embed URL
# https://www.google.com/maps?...), the JobRad calculator. Nothing is requested from them before the visitor clicks.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self'; frame-src https://www.etermin.net https://www.google.com/maps https://www.google.com/maps/ https://bike-leasing-calculator.jobrad.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cloudflare Pages preview deployments (*.pages.dev) stay out of search; the production
# host has no such rule, and the build adds a meta robots noindex unless PUBLIC_INDEXABLE=true.
https://*.pages.dev/*
  X-Robots-Tag: noindex

# Development domain: never indexed
https://bike-one.dev/*
  X-Robots-Tag: noindex
