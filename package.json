{
  "name": "bikeone",
  "version": "0.0.0",
  "description": "Static Astro rebuild of bike-one.org",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node tools/redirects-build.mjs --dist && node tools/sitemap-build.mjs && node tools/dev-origin.mjs",
    "preview": "astro preview",
    "test": "node --test \"test/**/*.test.mjs\"",
    "verify": "node tools/verify.mjs",
    "verify:release": "PUBLIC_INDEXABLE=true node tools/verify.mjs",
    "redirects": "node tools/checks/redirects.mjs",
    "links": "node tools/checks/links.mjs",
    "seo": "node tools/checks/seo.mjs",
    "wp": "node tools/checks/wp.mjs",
    "net": "node tools/checks/net.mjs",
    "size": "node tools/checks/size.mjs",
    "a11y": "node tools/checks/a11y.mjs",
    "baseline": "node scripts/build-baseline.mjs --capture capture --out baseline",
    "assets:copy": "node scripts/copy-assets.mjs --capture capture --site .",
    "links:exceptions": "node scripts/link-exceptions.mjs --baseline baseline --capture capture --out exceptions.json --skip-api",
    "redirects:build": "node tools/redirects-build.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "review:shoot": "node scripts/review/shoot.mjs",
    "review:diff": "node scripts/review/diff.mjs",
    "review:styles": "node scripts/review/styles.mjs",
    "review:sheet": "node scripts/review/sheet.mjs",
    "review:check": "node scripts/review/check.mjs --review review",
    "review:serve": "node scripts/review-serve.mjs",
    "verify:legacy": "node tools/verify-legacy.mjs",
    "verify:legacy:release": "PUBLIC_INDEXABLE=true node tools/verify-legacy.mjs"
  },
  "devDependencies": {
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-condensed": "5.3.0",
    "astro": "7.4.13",
    "css-tree": "3.2.1",
    "parse5": "8.0.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0"
  }
}
